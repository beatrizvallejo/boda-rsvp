# Copia este archivo a .env y rellénalo tú. Claude no puede leer .env.

# ── Desarrollo (fases 0–6): no hace falta ninguna cuenta externa ──
DATA_ADAPTER=local            # local = Nitro storage en .data/ | supabase (fase 8)
AUTH_ADAPTER=dev              # dev = acceso al panel sin login, SOLO en dev | supabase (fase 8)
NOTIFIER_ADAPTER=console      # console = el aviso se imprime en el log | gmail (fase 8)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Producción (fases 7–9): se completa con el compañero de devops ──
# SUPABASE_URL=
# SUPABASE_KEY=
# SUPABASE_SERVICE_KEY=          # solo servidor
# GMAIL_USER=
# GMAIL_APP_PASSWORD=            # solo servidor; revocar tras la boda
# NOTIFY_TO=                     # emails de los novios, separados por coma
# CRON_SECRET=                   # protege el endpoint del cron anti-pausa
# Turnstile solo si se elige formulario abierto (ver docs/produccion.md)
