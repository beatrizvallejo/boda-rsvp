# Copia este archivo a .env y rellénalo tú. Claude no puede leer .env.

# ── Desarrollo (fases 0–6): no hace falta ninguna cuenta externa ──
DATA_ADAPTER=local            # local = Nitro storage en .data/ | kv (fase 8)
AUTH_ADAPTER=dev              # dev = acceso al panel sin login, SOLO en dev | password = contraseña compartida
# Para probar el login en local: AUTH_ADAPTER=password y descomenta ADMIN_PASSWORD y NUXT_SESSION_PASSWORD
NOTIFIER_ADAPTER=console      # console = el aviso se imprime en el log | gmail (fase 8)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Producción (fases 7–9): se completa con el compañero de devops ──
# ADMIN_PASSWORD=                # contraseña del panel (solo servidor); 4+ palabras al azar, mínimo 16 caracteres
# NUXT_SESSION_PASSWORD=         # ≥32 caracteres aleatorios (openssl rand -base64 32); sella la cookie del panel
# (credenciales del KV según P02)
# GMAIL_USER=
# GMAIL_APP_PASSWORD=            # solo servidor; revocar tras la boda
# NOTIFY_TO=                     # emails de los novios, separados por coma
